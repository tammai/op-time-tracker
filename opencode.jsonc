{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "pnpm dev*": "allow",
      "pnpm build*": "allow",
      "pnpm lint*": "allow",
      "pnpm test*": "allow",
      "pnpm type-check*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm add*": "allow",
      "pnpm remove*": "allow",
      "pnpm install*": "allow",
      "npx electron-vite*": "allow",
      "npx electron*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git pull*": "allow",
      "git stash*": "allow",
      "node tools/*": "allow",
      "*": "ask"
    }
  }
}