{
  "name": "op-time-tracker",
  "version": "1.3.1",
  "private": true,
  "description": "OpenProject Time Tracker — Electron desktop app",
  "type": "module",
  "author": {
    "name": "Tam Mai",
    "email": "tam.mai@bigin.vn"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "icons": "node tools/make-icons.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.test.json",
    "type-check:tests": "vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.118",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.10.0",
    "@pinia/colada": "^1.4.2",
    "@tiptap/core": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/markdown": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/vue-3": "^3",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^17.7.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "zod": "^4.4.3"
  }
}
