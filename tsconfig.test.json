{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "tests/**/*.test.ts",
    "tests/support/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/utils/**/*.ts"
  ],
  "exclude": ["tests/fixtures/**"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["electron-vite/node", "node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@shared/*": ["src/shared/*"],
      "@opentracker/preload": ["src/preload/index.ts"],
      "~~/*": ["./*"]
    }
  }
}